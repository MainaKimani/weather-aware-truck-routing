# Copy to backend/.env for local development. Never commit the real file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres and Redis are wired up in SPOT-13/SPOT-14.
# DATABASE_URL=postgres://spotter:spotter@localhost:5432/spotter
# REDIS_URL=redis://localhost:6379/0

# HERE Routing / Autosuggest key (SPOT-31). Open-Meteo needs no key.
# HERE_API_KEY=

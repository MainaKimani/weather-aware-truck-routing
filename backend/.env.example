# Local development: copy to backend/.env (optional; everything has a dev default).
# Keep comments on their own lines: django-environ reads "# ..." after a value
# as part of the value.
#
# Production reads real environment variables only (never .env). It needs
# DJANGO_SETTINGS_MODULE=config.settings.prod and every variable marked [prod].

DJANGO_DEBUG=true
# [prod]
DJANGO_SECRET_KEY=change-me
# [prod]
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# [prod] the site origin
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# [prod] Defaults to the local socket database "spotter" as the current OS user
# (createdb spotter). For docker compose's Postgres use the URL below.
# DATABASE_URL=postgres://spotter:spotter@localhost:5432/spotter

# [prod] Without REDIS_URL the cache is per-process local memory.
# REDIS_URL=redis://localhost:6379/0

# fake = deterministic providers, no network or keys (default locally; responses
# are flagged as demo). real = HERE + Open-Meteo (default in prod).
PROVIDERS=fake
# Demo storm for fake mode: demo (Route A wins on severe miles) or strong
# (Route B has No Travel).
FAKE_SCENARIO=demo

# [prod] HERE Routing / Autosuggest key (SPOT-31). Open-Meteo needs no key.
# HERE_API_KEY=

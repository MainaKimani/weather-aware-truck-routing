# Local development: copy to backend/.env (optional; everything has a dev default).
# Keep comments on their own lines: django-environ reads "# ..." after a value
# as part of the value.
#
# Production reads real environment variables only (never .env). It needs
# DJANGO_SETTINGS_MODULE=config.settings.prod and every variable marked [prod].

DJANGO_DEBUG=true
# [prod]
DJANGO_SECRET_KEY=change-me
# [prod]
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# [prod] the site origin. Locally, leave it unset: the default trusts the
# frontend's dev server and preview (5173 and 4173, localhost and 127.0.0.1).
# CSRF_TRUSTED_ORIGINS=http://localhost:5173

# [prod] Defaults to the local socket database "spotter" as the current OS user
# (createdb spotter). For docker compose's Postgres use the URL below.
# DATABASE_URL=postgres://spotter:spotter@localhost:5432/spotter

# [prod] Without REDIS_URL the cache is per-process local memory.
# REDIS_URL=redis://localhost:6379/0

# fake = deterministic providers, no network or keys (default locally; responses
# are flagged as demo). real = HERE + Open-Meteo (default in prod).
PROVIDERS=fake
# Demo storm for fake mode: demo (Route A wins on severe miles) or strong
# (Route B has No Travel).
FAKE_SCENARIO=demo

# [prod] The reviewer's demo account, made or reset by `manage.py seed_demo`.
# DEMO_EMAIL=demo@example.com
# DEMO_PASSWORD=

# [prod] HERE Routing / Autosuggest key. Open-Meteo needs no key.
# HERE_API_KEY=
# HERE's free monthly transactions per service; calls stop at 90% of each.
# HERE_ROUTING_MONTHLY_ALLOWANCE=4000
# HERE_AUTOSUGGEST_MONTHLY_ALLOWANCE=4000

# [prod, depends on host] Proxies in front of Django that append to
# X-Forwarded-For; rate limits key on the client address this yields.
# 0 (default) uses the connecting address only.
# NUM_PROXIES=1

# [prod, optional] HSTS max-age in seconds; defaults to a year.
# SECURE_HSTS_SECONDS=31536000

# Logs: json (default in prod) or plain (default locally); level INFO by default.
# LOG_FORMAT=plain
# LOG_LEVEL=INFO
